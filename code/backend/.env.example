# server (read by the root main.py launcher)
HOST=127.0.0.1
PORT=8000
RELOAD=true

MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_CHAT_MODEL=openai/gpt-4o-mini
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small

DATABASE_URL=sqlite:///./data/smartreco.db
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=smartreco_products

# auto | chroma | keyword — "auto" falls back to keyword retrieval when Mesh
# embeddings are unavailable (see docs/phases/phase-05-agent.md)
RETRIEVAL_BACKEND=auto
RETRIEVAL_TOP_K=12
RETRIEVAL_SIMILARITY_THRESHOLD=0.20
RETRIEVAL_MIN_CANDIDATES=4

SESSION_SECRET=change-me

TRIGGER_DELTA_THRESHOLD=10.0
TRIGGER_COOLDOWN_MINUTES=10

# bonus
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
ENABLE_SCHEDULER=false
