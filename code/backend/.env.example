# server (read by the root main.py launcher)
HOST=127.0.0.1
PORT=8000
RELOAD=true

MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_CHAT_MODEL=openai/gpt-4o-mini
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small

DATABASE_URL=sqlite:///./data/smartreco.db
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=smartreco_products

# auto | chroma | keyword — "auto" falls back to keyword retrieval when Mesh
# embeddings are unavailable (see docs/phases/phase-05-agent.md)
RETRIEVAL_BACKEND=auto
RETRIEVAL_TOP_K=12
# Raise this to remove weak-correlation candidates (0.20-0.30 band is mostly noise).
# Scores below 0.20 are tangential; [0.20-0.30) are weakly correlated.
# Recommended: 0.30 gives a tighter funnel without losing signal.
RETRIEVAL_SIMILARITY_THRESHOLD=0.30
RETRIEVAL_MIN_CANDIDATES=4

SESSION_SECRET=change-me

# Trigger delta: profiles are normalised into [-1, 1].  With HALF_LIFE_HOURS=0.75,
# a focused 90s session yields a first-batch delta of ~1.5 (category 1.0 + level 0.5).
# 2.0 fires after profile is established; 1.5 fires on any single meaningful batch.
# Set higher (e.g. 5.0) to require sustained cross-category interest.
TRIGGER_DELTA_THRESHOLD=2.0
# Minimum minutes between consecutive agent runs for the same user.
# Production: 10 (a recommendation is expensive and slow to act on).
# Demo / staging: 1 (lets both browsing phases produce visible different recommendations).
TRIGGER_COOLDOWN_MINUTES=10

# bonus
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
ENABLE_SCHEDULER=false
